# ---------------------------------------------------------------------------
# Примерен конфигурационен файл. Копирайте го като .env и попълнете стойностите:
#     copy .env.example .env
# Файлът .env НЕ се качва в хранилището (виж .gitignore).
# ---------------------------------------------------------------------------

# Таен ключ на Django. В реална среда трябва да е дълъг случаен низ.
# Използва се и за подписване на QR кодовете на билетите.
SECRET_KEY=changeme-generate-a-new-secret-key

# Режим на разработка. В продукция задължително DEBUG=False
DEBUG=True

# Домейни, от които се приемат заявки (разделени със запетая)
ALLOWED_HOSTS=127.0.0.1,localhost

# --- База данни PostgreSQL ---
DB_NAME=event_management
DB_USER=ems_user
DB_PASSWORD=ems_password
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Имейл ---
# При DEBUG=True писмата се извеждат в конзолата и не се изпращат реално.
# За реално изпращане задайте DEBUG=False и попълнете SMTP настройките.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Система за управление на събития <no-reply@events.local>

# Базов адрес, използван в изпращаните имейли за връзки към билетите
SITE_URL=http://127.0.0.1:8000
